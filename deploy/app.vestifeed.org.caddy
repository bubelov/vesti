app.vestifeed.org {
	encode gzip

	# Cross-origin isolation enables SharedArrayBuffer / OPFS for the SQLite
	# WASM worker, so the browser database persists.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy cross-origin
		X-Content-Type-Options nosniff
		-Server
	}

	# Same-origin relay for standalone feed fetches and OpenGraph images.
	handle /proxy* {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv/http/app.vestifeed.org

		# route keeps these two in the written order: the default no-cache
		# first, then the immutable override for content-hashed files.
		route {
			# Everything must be revalidated by default -- index.html
			# (served at / too), vesti.js, the sqlite worker and the
			# unhashed webpack chunks -- so a new deploy can never be mixed
			# with stale files.
			header Cache-Control "no-cache, must-revalidate"

			# Only content-hashed artifacts are immutable. Their names
			# (20 hex chars) change with every build, e.g.
			# /4a51dc0b4a8e3c4ac422.wasm.
			@immutable path_regexp hashed ^/[0-9a-f]{20}\.(wasm|js)$
			header @immutable Cache-Control "public, max-age=31536000, immutable"
		}

		file_server
	}

	log {
		output file /var/log/caddy/app.vestifeed.org.access.log {
			roll_size 1gb
			roll_keep 5
		}
		format json
	}
}
